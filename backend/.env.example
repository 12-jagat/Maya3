# Application Settings
APP_NAME=MAYA
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# CORS Configuration (comma-separated or single URL)
FRONTEND_URL=http://localhost:5173

# AI & LLM (Google Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Relational Database (Supabase PostgreSQL)
SUPABASE_URL=
SUPABASE_KEY=

# Vector Database (Zilliz Cloud / Milvus)
ZILLIZ_URI=
ZILLIZ_TOKEN=

# Embedding Model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=64
CHUNK_SIZE=700
CHUNK_OVERLAP=120
ZILLIZ_COLLECTION=maya_notice_chunks


# Milestone 3: Crawler & Document Processing Configuration
PDF_WORKERS=8
PDF_DOWNLOAD_CONCURRENCY=10
PDF_MAX_SIZE_MB=30
OCR_ENABLED=true
STORAGE_DIR=storage

# Milestone 5: Conversational RAG Configuration
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.45
MAX_CONVERSATION_HISTORY=8
RAG_MAX_CONTEXT_TOKENS=3500

# Milestone 6: Multimodal Interaction Configuration
MAX_IMAGE_SIZE_MB=10
MAX_DOCUMENT_SIZE_MB=30
MAX_AUDIO_SIZE_MB=20
MAX_AUDIO_DURATION_SECONDS=300
UPLOAD_DIR=storage/uploads

